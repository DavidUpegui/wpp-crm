# Copy to .env.local and fill in. Never commit .env.local.

# Database (matches docker-compose.yml)
DATABASE_URL=postgres://crm:crm@localhost:5432/wpp_crm
# Integration tests only (`pnpm test:integration`); created and migrated automatically
DATABASE_URL_TEST=postgres://crm:crm@localhost:5432/wpp_crm_test

# Auth
BETTER_AUTH_SECRET=change-me-32-chars-min
BETTER_AUTH_URL=http://localhost:3000

# Meta app
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=            # System User permanent token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=    # any random string; same value in Meta dashboard
